# Reinstalled from package-lock.json
node_modules/

# Vite output; also contains a copy of everything in frontend/public/
dist/

# Python bytecode and local virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store

# Generated frontend data assets: 292 MB of int16 vertex data and its layout,
# written by scripts/07_build_network.py then scripts/08_build_network_points.py
frontend/public/points.bin
frontend/public/layout.json

# Paper supplementary files >4 MB, redownloadable from doi:10.1186/s13321-016-0174-y
# (MOESM3 .csv is 118 MB, over GitHub's 100 MB per-file limit)
data/paper_supplementary/*.csv
data/paper_supplementary/*.docx
data/paper_supplementary/*.pdf

# Derived result >4 MB (12 MB, 1,047,341 pairs), regenerated by scripts/02_scan_dataset.py
results/dp_alt_pairs.tsv

# The 2 GB Zenodo dataset (10.5281/zenodo.20472700) and the 67 MB sample cut from
# it. The pipeline reads them from ../chemont_project/data/, but ignore any copy.
*.tsv.zst
sample_200k.tsv
